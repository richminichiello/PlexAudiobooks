# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc.)
local.properties

# Native build output (NDK)
.cxx/

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
*.iml
.idea/caches/
.idea/libraries/
.idea/modules/
.idea/workspace.xml
.idea/tasks.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/shelf
.idea/.name
.idea/.gitignore
.idea/navSettings.xml
# AS 2.3+ device/emulator streaming cache (machine-local — do not track)
.idea/caches/deviceStreaming.xml
# Android Studio's Gemini/StudioBot per-project settings
.idea/studiobot.xml
# Keystore files — never commit signing keys
*.jks
*.keystore

# External native build files generated in Android Studio 2.2+
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Version control
vcs.xml

# OS-specific
.DS_Store
Thumbs.db
