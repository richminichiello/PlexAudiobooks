<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authFragment">

    <!-- Onboarding (start destination chosen at runtime in MainActivity) -->
    <fragment
        android:id="@+id/authFragment"
        android:name="com.plexaudiobooks.ui.auth.AuthFragment"
        android:label="Sign In"
        tools:layout="@layout/fragment_auth">
        <action
            android:id="@+id/action_auth_to_serverSetup"
            app:destination="@id/serverSetupFragment"
            app:popUpTo="@id/authFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/serverSetupFragment"
        android:name="com.plexaudiobooks.ui.auth.ServerSetupFragment"
        android:label="Connect to Plex"
        tools:layout="@layout/fragment_server_setup">
        <action
            android:id="@+id/action_serverSetup_to_library"
            app:destination="@id/libraryFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Top-level tab destinations (bottom nav). Player is NOT a destination — it is a
         sheet shown over whichever tab is active, driven by PlaybackManager. -->
    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.plexaudiobooks.ui.library.LibraryFragment"
        android:label="My Library"
        tools:layout="@layout/fragment_library">
        <action
            android:id="@+id/action_library_to_detail"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.plexaudiobooks.ui.player.NowPlayingTabFragment"
        android:label="Now Playing"
        tools:layout="@layout/fragment_player" />

    <fragment
        android:id="@+id/downloadsFragment"
        android:name="com.plexaudiobooks.ui.downloads.DownloadsFragment"
        android:label="Downloads"
        tools:layout="@layout/fragment_downloads" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.plexaudiobooks.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_serverSetup"
            app:destination="@id/serverSetupFragment" />
        <action
            android:id="@+id/action_settings_to_auth"
            app:destination="@id/authFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Book detail. Play now happens via PlaybackManager + the player sheet, not via nav. -->
    <fragment
        android:id="@+id/detailFragment"
        android:name="com.plexaudiobooks.ui.detail.DetailFragment"
        android:label="Book Details"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="ratingKey"
            app:argType="string" />
    </fragment>

</navigation>
